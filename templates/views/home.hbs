<div class="ht-apps">
  {{#each apps}}
  <button type="button" class="ht-app-tile ht-tone-{{tone}}" {{#if action}}data-action="{{action}}"{{else}}data-action="go" data-view="{{view}}"{{/if}}>
    <span class="ht-badge"><i class="fas {{icon}}"></i></span><span class="ht-app-label">{{label}}</span>
  </button>
  {{/each}}
</div>
