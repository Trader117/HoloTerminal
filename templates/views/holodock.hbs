{{#if ship}}
{{#with ship}}
<div class="ht-dock-head">
  <img src="{{img}}" alt="">
  <div>
    {{#if party}}<span class="ht-dock-tag">Party ship</span>{{/if}}
    <div class="ht-dock-meta">{{#if size}}{{size}} starship &middot; {{/if}}{{#if (ne tier null)}}Tier {{tier}} &middot; {{/if}}{{#if hyper}}Hyperdrive class {{hyper}}{{else}}No hyperdrive{{/if}}</div>
    {{#if location}}<div class="ht-dock-loc"><i class="fas fa-location-dot"></i> {{location}}</div>{{/if}}
  </div>
</div>
{{#if ../locked}}<p class="ht-dim">Access restricted. You can see this ship on the registry, but not its systems.</p>
{{else}}
<div class="ht-dock-bars">
  <div class="ht-dock-bar ht-tone-hull{{#if hull.low}} low{{/if}}"><span>Hull</span><div class="ht-charge"><span style="width:{{hull.pct}}%"></span></div><b>{{hull.value}}{{#if hull.max}}/{{hull.max}}{{/if}}</b></div>
  {{#if shields}}<div class="ht-dock-bar ht-tone-shields{{#if shields.low}} low{{/if}}"><span>Shields</span><div class="ht-charge"><span style="width:{{shields.pct}}%"></span></div><b>{{shields.value}}{{#if shields.max}}/{{shields.max}}{{/if}}</b></div>{{/if}}
  <div class="ht-dock-bar ht-tone-fuel{{#if fuel.low}} low{{/if}}"><span>Fuel</span><div class="ht-charge"><span style="width:{{fuel.pct}}%"></span></div><b>{{fuel.value}}{{#if fuel.max}}/{{fuel.max}}{{/if}}</b></div>
</div>
<div class="ht-dock-stats">
  <div><small>Modifications</small><b>{{../lim.used}}{{#if ../lim.slots}} / {{../lim.slots}} slots{{/if}}</b></div>
  <div><small>Suites</small><b>{{../lim.suites}}{{#if (ne ../lim.suiteMax null)}} / {{../lim.suiteMax}}{{/if}}</b></div>
  <div><small>Cargo hold</small><b>{{cargoUsed}}{{#if cargoCap}} / {{cargoCap}}{{/if}} t</b></div>
  <div><small>Fuel price</small><b>{{fuel.price}} cr/unit</b></div>
  {{#if ../worth.value}}<div><small>Value</small><b>{{../worth.value}} cr <span class="ht-dim">resale {{../worth.resale}}</span></b></div>{{/if}}
</div>
<div class="ht-row ht-dock-actions">
  {{#if ../canSheet}}<button type="button" class="ht-primary" data-action="dockSheet"><i class="fas fa-id-card"></i> Ship sheet</button>{{/if}}
  {{#if party}}<button type="button" data-action="go" data-view="shipyard"><i class="fas fa-screwdriver-wrench"></i> Shipyard</button>{{/if}}
  {{#if ../canCommand}}<button type="button" data-action="go" data-view="hold" data-id="{{id}}"><i class="fas fa-boxes-stacked"></i> Cargo hold</button>{{/if}}
  {{#if party}}<button type="button" data-action="go" data-view="trade"><i class="fas fa-scale-balanced"></i> Trade</button>{{/if}}
  <button type="button" data-action="galaxy"><i class="fas fa-earth-americas"></i> Plot a jump</button>
</div>
{{#if ../canCommand}}
<h3 class="ht-dock-h">Fuel depot</h3>
<div class="ht-row ht-dock-actions">
  <button type="button" data-action="dockRefuel" data-units="1"{{#if fuel.max}}{{#if (eq fuel.value fuel.max)}} disabled{{/if}}{{/if}}><i class="fas fa-gas-pump"></i> {{#if ../isGM}}Add 1 fuel{{else}}Buy 1 fuel ({{fuel.price}} cr){{/if}}</button>
  {{#if fuel.max}}<button type="button" data-action="dockRefuel" data-units="fill"{{#if (eq fuel.value fuel.max)}} disabled{{/if}}><i class="fas fa-gas-pump"></i> Fill tanks{{#unless ../isGM}} ({{../fillCost}} cr){{/unless}}</button>{{/if}}
  {{#if ../payerName}}<span class="ht-dim">Paid by {{../payerName}} ({{../payerCredits}} cr)</span>{{/if}}
</div>
{{/if}}
{{/if}}
{{#if ../canSell}}
<h3 class="ht-dock-h">Ownership</h3>
<div class="ht-row ht-dock-actions">
  <button type="button" data-action="shipSell" data-resale="{{../worth.resale}}"{{#unless ../worth.resale}} disabled title="The GM can set the ship's value on its sheet (edit mode)"{{/unless}}><i class="fas fa-hand-holding-dollar"></i> Sell ship{{#if ../worth.resale}} ({{../worth.resale}} cr){{/if}}</button>
</div>
{{/if}}
{{#if ../isGM}}
<div class="ht-row ht-dock-actions">
  {{#if party}}<button type="button" data-action="dockParty" data-id=""><i class="fas fa-star"></i> Clear party ship</button>
  {{else}}<button type="button" data-action="dockParty" data-id="{{id}}"><i class="far fa-star"></i> Set as party ship</button>{{/if}}
</div>
{{/if}}
{{/with}}
{{else}}
<div class="ht-dock-ships">
  {{#each ships}}
  <button type="button" class="ht-dock-card{{#if party}} ht-dock-party{{/if}}" data-action="go" data-view="holodock" data-id="{{id}}">
    <img src="{{img}}" alt="">
    <span class="ht-dock-card-info">
      <span class="ht-dock-name">{{name}}{{#if party}} <span class="ht-dock-tag">Party</span>{{/if}}</span>
      <span class="ht-dock-meta">{{#if size}}{{size}} &middot; {{/if}}{{#if hyper}}Class {{hyper}}{{else}}No hyperdrive{{/if}}</span>
      {{#if observer}}
      <span class="ht-dock-mini ht-tone-hull{{#if hull.low}} low{{/if}}"><i style="width:{{hull.pct}}%"></i></span>
      {{#if shields}}<span class="ht-dock-mini ht-tone-shields{{#if shields.low}} low{{/if}}"><i style="width:{{shields.pct}}%"></i></span>{{/if}}
      <span class="ht-dock-mini ht-tone-fuel{{#if fuel.low}} low{{/if}}"><i style="width:{{fuel.pct}}%"></i></span>
      {{/if}}
    </span>
  </button>
  {{else}}<p class="ht-dim">No ships registered. {{#if isGM}}Import one below, or mark a ship in the GM Console's Ships tab.{{else}}The GM hasn't given you access to a ship yet. Ships for sale turn up in the Markets.{{/if}}</p>{{/each}}
</div>
{{#if isGM}}<div class="ht-row ht-dock-actions"><button type="button" data-action="dockImport"><i class="fas fa-file-import"></i> Import ship</button></div>{{/if}}
{{/if}}
