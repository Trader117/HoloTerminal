<div class="ht-feed{{#if playback}} ht-feed-tape{{/if}}" style="height: {{height}}px">
  <div class="ht-feed-layer" style="width: {{w}}px; height: {{h}}px; transform: scale({{scale}})">
    {{#if bg}}<img class="ht-feed-bg" src="{{bg}}" alt="" style="left: {{bgX}}px; top: {{bgY}}px; width: {{bgW}}px; height: {{bgH}}px">{{/if}}
    {{#each tiles}}<img class="ht-feed-tile" src="{{img}}" alt="" style="left: {{x}}px; top: {{y}}px; width: {{w}}px; height: {{h}}px; transform: rotate({{rot}}deg)">{{/each}}
    <div class="ht-feed-tokens">{{#each tokens}}<img class="ht-feed-token" data-token="{{id}}" src="{{img}}" alt="{{name}}" style="left: {{x}}px; top: {{y}}px; width: {{w}}px; height: {{h}}px; transform: rotate({{rot}}deg)">{{/each}}</div>
  </div>
  <div class="ht-feed-hud">
    <span class="ht-feed-label">{{label}}</span>
    {{#if playback}}<span class="ht-feed-tag">PLAYBACK</span>{{else if recording}}<span class="ht-feed-rec">&#9679; REC</span>{{else}}<span class="ht-feed-live">&#9679; LIVE</span>{{/if}}
  </div>
</div>
