{{#if noActor}}<p class="ht-dim">Select your token or assign a character to salvage.</p>{{/if}}
{{#each bodies}}
  <article class="ht-loot{{#unless near}} ht-far{{/unless}}">
    <header>
      {{#if img}}<img src="{{img}}" alt="">{{/if}}
      <span class="ht-loot-name">{{name}}</span>
      {{#unless near}}<span class="ht-tag">Out of reach</span>{{/unless}}
      {{#if credits}}<button type="button" class="ht-primary" data-action="lootCredits" data-token="{{id}}" {{#unless near}}disabled{{/unless}}>{{credits}} cr</button>{{/if}}
    </header>
    <ul>
      {{#each items}}
      <li>{{#if img}}<img src="{{img}}" alt="" width="24" height="24">{{/if}}<span>{{name}}{{#if qty}} &times;{{qty}}{{/if}}</span>
        <button type="button" data-action="lootItem" data-token="{{../id}}" data-item="{{id}}" {{#unless ../near}}disabled{{/unless}}>Take</button></li>
      {{/each}}
    </ul>
  </article>
{{else}}<p class="ht-dim">-- no salvage on this scene --</p>{{/each}}
