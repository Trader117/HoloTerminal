{{#if noShip}}<p class="ht-dim">{{noShip}}</p>
{{else}}
<div class="ht-trade-head">
  <div><small>Shipyard</small><b>{{planet.name}}</b><span class="ht-dock-meta">{{shipName}}</span></div>
  <div><small>{{#if payerName}}{{payerName}}{{else}}Credits{{/if}}</small><b>{{#if payerName}}{{payerCredits}} cr{{else}}—{{/if}}</b><span class="ht-dock-meta">Mods {{lim.used}}{{#if lim.slots}}/{{lim.slots}}{{/if}} &middot; suites {{lim.suites}}{{#if (ne lim.suiteMax null)}}/{{lim.suiteMax}}{{/if}}</span></div>
</div>
<nav class="ht-tabs ht-yard-tabs">{{#each modes}}<button type="button" data-action="yardMode" data-mode="{{id}}" class="{{#if active}}active{{/if}}"><i class="fas {{icon}}"></i> {{label}}</button>{{/each}}</nav>

{{#if (eq mode "repair")}}
<ul class="ht-bridge-list ht-yard-repairs">
  <li><span>Hull<small>{{#if rep.hull.missing}}{{rep.hull.missing}} points damaged &middot; {{rep.hull.per}} cr each{{else}}No damage{{/if}}</small></span>
    {{#if rep.hull.missing}}<button type="button" data-action="yardRepair" data-kind="hull" data-points="10">10 pts</button><button type="button" class="ht-primary" data-action="yardRepair" data-kind="hull" data-points="0">All ({{rep.hull.cost}} cr)</button>{{/if}}</li>
  <li><span>Shields<small>{{#if rep.shields.missing}}{{rep.shields.missing}} points down &middot; {{rep.shields.per}} cr each{{else}}Fully charged{{/if}}</small></span>
    {{#if rep.shields.missing}}<button type="button" class="ht-primary" data-action="yardRepair" data-kind="shields" data-points="0">Recharge ({{rep.shields.cost}} cr)</button>{{/if}}</li>
  {{#if (ne ship.systemDamage null)}}<li><span>System damage<small>{{#if rep.systems.missing}}Level {{rep.systems.missing}} &middot; {{rep.systems.per}} cr per level{{else}}All systems nominal{{/if}}</small></span>
    {{#if rep.systems.missing}}<button type="button" data-action="yardRepair" data-kind="systems" data-points="1">1 level</button><button type="button" class="ht-primary" data-action="yardRepair" data-kind="systems" data-points="0">All ({{rep.systems.cost}} cr)</button>{{/if}}</li>{{/if}}
</ul>
{{/if}}

{{#if (eq mode "buy")}}
<nav class="ht-tabs ht-yard-cats">{{#each cats}}<button type="button" data-action="yardTab" data-cat="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</nav>
{{#if modNote}}<p class="ht-dim ht-small">{{modNote}}</p>{{/if}}
<input class="ht-yard-search" name="yard-q" type="search" placeholder="Search {{catLabel}}..." value="{{query}}">
<ul class="ht-bridge-list">
  {{#each rows}}<li class="{{#if blocked}}ht-yard-blocked{{/if}}"><img src="{{img}}" alt=""><span>{{name}}<small>{{sub}}{{#if (ne grade null)}} &middot; grade {{grade}}{{#if dc}} &middot; install DC {{dc}}{{/if}}{{/if}}{{#if replaces}} &middot; replaces {{replaces}}{{/if}}{{#if prereq}} &middot; needs {{prereq}}{{/if}}{{#if blocked}}<em class="ht-warn"> {{blocked}}</em>{{/if}}</small></span>
    <b class="ht-yard-price">{{price}} cr</b><button type="button" data-action="yardBuy" data-key="{{key}}" data-name="{{name}}" data-price="{{price}}"{{#if blocked}}{{#unless ../isGM}} disabled{{/unless}}{{/if}} title="{{#if blocked}}{{blocked}}{{else}}Buy and install{{/if}}">Buy</button></li>
  {{else}}<li class="ht-dim">Nothing matches.</li>{{/each}}
</ul>
{{#if more}}<p class="ht-dim">{{more}} more. Search to narrow it down.</p>{{/if}}
{{/if}}

{{#if (eq mode "sell")}}
<p class="ht-dim ht-small">The shipyard pays {{resalePct}}% of what a part is worth.{{#unless payerName}} Pick your character so the credits have somewhere to go.{{/unless}}</p>
<ul class="ht-bridge-list">
  {{#each parts}}<li><img src="{{img}}" alt=""><span>{{name}}<small>{{label}}{{#if sub}} &middot; {{sub}}{{/if}}{{#if qty}} &middot; &times;{{qty}}{{/if}}</small></span>
    <b class="ht-yard-price">{{value}} cr{{#if qty}} ea{{/if}}</b><button type="button" data-action="yardSell" data-id="{{id}}" data-name="{{name}}" data-price="{{value}}">Sell{{#if qty}} 1{{/if}}</button></li>
  {{else}}<li class="ht-dim">No weapons, systems, ammunition or modifications to sell.</li>{{/each}}
</ul>
{{/if}}
{{/if}}
