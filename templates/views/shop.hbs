{{#if missing}}<p>This vendor has closed.</p>{{else}}
  {{#if shop.description}}<p class="ht-dim">{{shop.description}}</p>{{/if}}
  {{#if isGM}}<button type="button" data-action="edit" data-kind="shops" data-id="{{shop.id}}">Edit stock</button>{{/if}}
  <table class="ht-shop">
    <thead><tr><th></th><th>Item</th><th>Stock</th><th>Price</th><th></th></tr></thead>
    <tbody>
    {{#each items}}
      <tr class="{{#if soldOut}}ht-dim{{/if}}">
        <td>{{#if img}}<img src="{{img}}" alt="" width="28" height="28">{{/if}}</td>
        <td>{{name}}</td>
        <td>{{#if infinite}}&infin;{{else}}{{stock}}{{/if}}</td>
        <td>{{price}} cr</td>
        <td><button type="button" data-action="buy" data-index="{{index}}" {{#unless affordable}}disabled{{/unless}}>{{#if soldOut}}Sold out{{else}}Buy{{/if}}</button></td>
      </tr>
    {{else}}<tr><td colspan="5" class="ht-dim">-- shelves empty --</td></tr>{{/each}}
    </tbody>
  </table>
{{/if}}
