{{#if missing}}<p>Connection lost.</p>
{{else if locked}}
  <div class="ht-login">
    <p class="ht-big">&#128274; SECURED NODE</p>
    {{#if denied}}<p class="ht-denied">ACCESS DENIED</p>{{/if}}
    {{#if hasPassword}}
      <input type="password" name="password" placeholder="{{localize 'HT.password'}}" autocomplete="off">
      <button type="button" data-action="login">{{localize "HT.login"}}</button>
    {{/if}}
    {{#if slice}}<button type="button" data-action="go" data-view="slice" data-id="{{terminal.id}}">{{localize "HT.slice"}}</button>{{/if}}
  </div>
{{else}}
  <nav class="ht-tabs">{{#each tabs}}<button type="button" data-action="switchTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</nav>
  {{#if (eq tab "messages")}}
    {{#each messages}}{{> cryptEntry title=titleText}}{{else}}<p class="ht-dim">-- inbox empty --</p>{{/each}}
  {{/if}}
  {{#if (eq tab "files")}}
    {{#each files}}{{> cryptEntry}}{{else}}<p class="ht-dim">-- no files --</p>{{/each}}
  {{/if}}
  {{#if (eq tab "controls")}}
    {{#each controls}}<div class="ht-control ht-tone-{{tone}}"><i class="fas {{icon}} ht-control-icon"></i><span>{{label}}</span><button type="button" data-action="control" data-index="{{index}}" {{#if (eq tone "off")}}disabled{{/if}}><span class="ht-led"></span>{{state}}</button></div>
    {{else}}<p class="ht-dim">-- no linked systems --</p>{{/each}}
  {{/if}}
  {{#if (eq tab "cameras")}}{{> camerasTab}}{{/if}}
{{/if}}
