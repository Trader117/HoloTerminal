{{#if noShip}}<p class="ht-dim">{{noShip}}</p>
{{else}}
<div class="ht-trade-head">
  <div><small>Docked at</small><b>{{planet.name}}</b><span class="ht-dock-meta">{{planet.region}}{{#if planet.terrain}} &middot; {{planet.terrain}}{{/if}}</span></div>
  <div><small>{{shipName}} hold</small><b>{{used}}{{#if cap}} / {{cap}}{{/if}} t</b>{{#if cap}}<div class="ht-charge" style="--sig:var(--ht-gold)"><span style="width:{{pct}}%"></span></div>{{/if}}</div>
</div>
<table class="ht-trade">
  <thead><tr><th>Cargo</th><th>Buy</th><th>Sell</th><th>Hold</th><th></th></tr></thead>
  <tbody>
  {{#each goods}}
  <tr class="{{#if restricted}}restricted{{/if}}">
    <td><span class="ht-trade-name">{{name}}</span>{{#if cheap}}<small class="ht-trade-tag good" title="{{pct}}% against the galactic average: buy here">cheap</small>{{/if}}{{#if wanted}}<small class="ht-trade-tag gold" title="+{{pct}}% against the galactic average: sell here">wanted</small>{{/if}}{{#if restricted}}<small class="ht-trade-tag red" title="Contraband in most places. It pays more, but buying or selling it may draw attention, and the sale makes the HoloNet news. The GM decides the risk.">restricted</small>{{/if}}</td>
    <td class="num{{#if cheap}} ht-price-cheap{{/if}}">{{#if stocked}}{{buy}}{{else}}<span class="ht-dim" title="Not sold here">--</span>{{/if}}</td>
    <td class="num{{#if wanted}} ht-price-wanted{{/if}}">{{sell}}</td>
    <td class="num">{{#if held}}{{held}} t{{#if paidTxt}}<small>{{paidTxt}}</small>{{/if}}{{/if}}</td>
    <td class="ht-trade-btns">
      {{#if ../canTrade}}
      {{#if stocked}}<button type="button" data-action="tradeBuy" data-good="{{id}}" data-tons="1" title="Buy 1 t">+1</button><button type="button" data-action="tradeBuy" data-good="{{id}}" data-tons="5" title="Buy 5 t">+5</button>{{/if}}
      {{#if held}}<button type="button" data-action="tradeSell" data-good="{{id}}" data-tons="{{held}}" class="ht-primary" title="Sell all">Sell</button>{{/if}}
      {{/if}}
    </td>
  </tr>
  {{/each}}
  </tbody>
</table>
<p class="ht-dim ht-trade-help">Prices are credits per ton. Green buy prices are cheaper than the galactic average, gold sell prices are above it: buy green, sell gold. "--" means the world doesn't sell that good, but it will still buy it. Restricted goods are contraband: they pay more, and the GM decides the risk. Your active character pays and is paid.</p>
{{#if isGM}}<div class="ht-row"><button type="button" data-action="tradeShift" title="New prices on every world"><i class="fas fa-shuffle"></i> Shift markets</button></div>{{/if}}
{{/if}}
