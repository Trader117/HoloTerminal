<div class="ht-device">
  <div class="ht-bezel-top" title="Drag to move"></div>
  <span class="ht-rail ht-rail-l" aria-hidden="true"></span><span class="ht-rail ht-rail-r" aria-hidden="true"></span>
  <div class="ht-screen ht-theme-{{theme}}">
    <div class="ht-glyphline">{{{glyphLine}}}</div>
    <header class="ht-header">
      <div class="ht-kicker"><span>{{kicker}}</span><span class="ht-clock">{{#if actorName}}{{actorName}} &middot; {{/if}}{{clock}}</span></div>
      <div class="ht-title">{{title}}</div>
    </header>
    {{#if booting}}<pre class="ht-boot">{{bootText}}</pre>
    {{else}}<section class="ht-body">{{> (lookup this "partial")}}</section>{{/if}}
  </div>
  <nav class="ht-controls">
    <div class="ht-keys">
      {{#each keys}}
      <button type="button" class="ht-key" data-action="{{action}}" {{#if view}}data-view="{{view}}"{{/if}} title="{{label}}">{{{glyph}}}</button>
      {{/each}}
    </div>
    <div class="ht-grille" aria-hidden="true"></div>
    <div class="ht-keys">
      <button type="button" class="ht-key ht-arrow" data-action="back" title="Back" {{#unless canBack}}disabled{{/unless}}><span class="ht-tri ht-tri-l"></span></button>
      <button type="button" class="ht-key ht-arrow" data-action="forward" title="Forward" {{#unless canForward}}disabled{{/unless}}><span class="ht-tri ht-tri-r"></span></button>
      <div class="ht-readout" title="Credits">{{#if (ne credits null)}}{{credits}}<small>cr</small>{{else}}-----{{/if}}</div>
    </div>
  </nav>
</div>
