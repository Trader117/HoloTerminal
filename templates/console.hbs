<div class="ht-console">
  <nav class="ht-tabs">{{#each tabs}}<button type="button" data-action="switchTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</nav>
  {{#if isScanners}}
  <section class="ht-body ht-sc">
    <details class="ht-sc-give" open>
      <summary><i class="fas fa-plus"></i> Give scanner</summary>
      <div class="ht-sc-grid">
        <label>Character <select name="sc-actor">{{#each actors}}<option value="{{id}}">{{name}}</option>{{else}}<option value="">No player characters</option>{{/each}}</select></label>
        <label>Signal <select name="sc-signal">{{#each sigOpts}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
        <label>Range ({{units}}) <input name="sc-range" type="number" min="1" value="30"></label>
        <label>Pulse <select name="sc-style">{{#each styleOpts}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
        <label>Name <input name="sc-name" type="text" placeholder="e.g. Field Scanner"></label>
        <label class="ht-sc-charges"><span class="ht-check"><input name="sc-limited" type="checkbox"> Limited charges</span><input name="sc-max" type="number" min="1" value="5" title="Capacity"></label>
      </div>
      <div class="ht-row">
        <button type="button" data-action="scGive" class="ht-primary"><i class="fas fa-satellite-dish"></i> Give scanner</button>
        <button type="button" data-action="scPreviewForm" title="Select a token on the map first. Local only, uses no charge."><i class="fas fa-eye"></i> Preview</button>
      </div>
    </details>

    <h3 class="ht-sc-h">Assigned scanners</h3>
    {{#each owners}}
    <div class="ht-sc-owner" data-actor="{{id}}">
      <div class="ht-sc-owner-name">{{#if img}}<img src="{{img}}" alt="">{{/if}}{{name}}</div>
      <ul>
        {{#each scanners}}
        <li class="ht-entry" data-scanner="{{id}}">
          <span class="ht-sc-sig" style="--sig:{{sig.color}}"><i class="fas {{sig.icon}}"></i></span>
          <span class="ht-entry-name">{{name}}<small>{{sig.label}} · {{range}} {{../../units}} · {{styleLabel}} · {{#if limited}}{{charges}}/{{max}} charges{{else}}unlimited{{/if}}</small></span>
          <button type="button" data-action="scPreview" title="Preview from the selected token"><i class="fas fa-eye"></i></button>
          {{#if canRecharge}}<button type="button" data-action="scRecharge" title="Recharge"><i class="fas fa-battery-half"></i></button>{{/if}}
          <button type="button" data-action="scEdit" title="Edit"><i class="fas fa-pen"></i></button>
          <button type="button" data-action="scDelete" title="Remove"><i class="fas fa-trash"></i></button>
        </li>
        {{/each}}
      </ul>
    </div>
    {{else}}<p class="ht-dim">No one has a scanner yet.</p>{{/each}}

    <h3 class="ht-sc-h">Targets on {{sceneName}}</h3>
    <p class="ht-dim ht-sc-help">Draw a Region over the target, then add the <b>Scan Signature</b> behaviour to it (Region config, Behaviors, +). One Region can hold several shapes, and each one lights up on its own.</p>
    <ul>
      {{#each targets}}
      <li class="ht-entry{{#if resolved}} ht-resolved{{/if}}">
        <span class="ht-sc-sig" style="--sig:{{color}}"><i class="fas fa-crosshairs"></i></span>
        <span class="ht-entry-name">{{name}}<small>{{signal}} · {{regionName}} · {{areas}} area{{#unless (eq areas 1)}}s{{/unless}}{{#if resolved}} · resolved{{/if}}{{#if unmatched}} · <span class="ht-warn">no scanner uses this signal</span>{{/if}}</small></span>
        <button type="button" data-action="tgPreview" data-uuid="{{uuid}}" title="Preview on map"><i class="fas fa-eye"></i></button>
        <button type="button" data-action="tgToggle" data-uuid="{{uuid}}" title="{{#if resolved}}Enable scanning again{{else}}Mark resolved{{/if}}"><i class="fas {{#if resolved}}fa-rotate-left{{else}}fa-check{{/if}}"></i></button>
        <button type="button" data-action="tgEdit" data-uuid="{{uuid}}" title="Edit"><i class="fas fa-pen"></i></button>
      </li>
      {{else}}<li class="ht-dim">No scan targets on this scene.</li>{{/each}}
    </ul>
  </section>
  {{else if isComms}}
  <section class="ht-body ht-sc">
    <details class="ht-sc-give" open>
      <summary><i class="fas fa-tower-broadcast"></i> Send a message</summary>
      <div class="ht-sc-grid">
        <label>From <select name="cm-from"><option value="anon">Anonymous / alias</option><optgroup label="NPCs and others">{{#each others}}<option value="{{id}}">{{name}}</option>{{/each}}</optgroup><optgroup label="Player characters">{{#each pcs}}<option value="{{id}}">{{name}}</option>{{/each}}</optgroup></select></label>
        <label>To <select name="cm-to"><option value="all">Everyone (broadcast)</option>{{#each pcs}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
        <label>Alias (anonymous only) <input name="cm-alias" type="text" placeholder="e.g. A friend"></label>
      </div>
      <textarea name="cm-text" rows="3" placeholder="Message"></textarea>
      <div class="ht-row"><button type="button" class="ht-primary" data-action="cmSend"><i class="fas fa-paper-plane"></i> Transmit</button></div>
    </details>
    <details class="ht-sc-give">
      <summary><i class="fas fa-satellite"></i> Holocall</summary>
      <div class="ht-sc-grid">
        <label>Caller <select name="cm-caller"><option value="anon">Unknown caller</option>{{#each others}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
        <label>Name shown <input name="cm-callname" type="text" placeholder="Actor's name"></label>
      </div>
      <div class="ht-cm-users">{{#each players}}<label class="ht-check"><input type="checkbox" name="cm-user" value="{{id}}" {{#if active}}checked{{/if}}> {{name}}</label>{{/each}}</div>
      <input name="cm-callline" type="text" placeholder="Opening line (optional)">
      <div class="ht-row"><button type="button" class="ht-primary" data-action="cmCall" title="Untick everyone to call all players"><i class="fas fa-phone"></i> Start call</button></div>
    </details>
    <h3 class="ht-sc-h">Comms log{{#unless gmRead}} <small class="ht-dim">(private player messages hidden)</small>{{/unless}}</h3>
    <ul>
      {{#each log}}
      <li class="ht-entry">
        <span class="ht-entry-name"><span>{{from}} <i class="fas fa-arrow-right"></i> {{to}}</span><small>{{time}}{{#if private}} · between players{{/if}}</small><span class="ht-cm-text">{{text}}</span></span>
        <button type="button" data-action="cmDelete" data-id="{{id}}" title="Delete"><i class="fas fa-trash"></i></button>
      </li>
      {{else}}<li class="ht-dim">No transmissions yet.</li>{{/each}}
    </ul>
    <div class="ht-row"><button type="button" data-action="cmClear"><i class="fas fa-broom"></i> Clear all</button></div>
  </section>
  {{else if isShips}}
  <section class="ht-body ht-sc">
    <div class="ht-row ht-dock-addship">
      <select name="ship-actor">{{#each candidates}}<option value="{{id}}">{{name}}</option>{{else}}<option value="">No other actors</option>{{/each}}</select>
      <button type="button" data-action="shipAdd" title="Use a vehicle or NPC actor as a ship"><i class="fas fa-plus"></i> Add as ship</button>
    </div>
    <p class="ht-dim ht-sc-help">SW5e starship actors are listed on their own. Players see the party ship plus any ship they have Limited rights on (Observer to read its systems, Owner to buy fuel and load cargo). The party ship sets the galaxy map's ship marker and route speed.</p>
    <ul>
      {{#each ships}}
      <li class="ht-entry">
        <button type="button" data-action="shipParty" data-id="{{id}}" title="{{#if party}}Party ship (click to clear){{else}}Set as party ship{{/if}}" class="ht-dock-star{{#if party}} on{{/if}}"><i class="{{#if party}}fas{{else}}far{{/if}} fa-star"></i></button>
        <span class="ht-entry-name">{{name}}<small>{{#if size}}{{size}} · {{/if}}{{#if hyper}}class {{hyper}}{{else}}no hyperdrive{{/if}} · hull {{hull.value}}{{#if hull.max}}/{{hull.max}}{{/if}}{{#if shields}} · shields {{shields.value}}{{/if}} · fuel {{fuel.value}}{{#if fuel.max}}/{{fuel.max}}{{/if}}{{#if location}} · {{location}}{{/if}}</small></span>
        <button type="button" data-action="shipOpen" data-id="{{id}}" title="Open"><i class="fas fa-up-right-from-square"></i></button>
        <button type="button" data-action="shipShow" data-id="{{id}}" title="Show to players"><i class="fas fa-users"></i></button>
        <button type="button" data-action="shipEdit" data-id="{{id}}" title="HoloDock settings"><i class="fas fa-pen"></i></button>
        {{#unless native}}<button type="button" data-action="shipRemove" data-id="{{id}}" title="Remove from HoloDock"><i class="fas fa-trash"></i></button>{{/unless}}
      </li>
      {{else}}<li class="ht-dim">No ships yet.</li>{{/each}}
    </ul>
    <details class="ht-sc-give">
      <summary><i class="fas fa-meteor"></i> Hyperspace events <small class="ht-dim">({{eventChance}}% per jump, set in module settings)</small></summary>
      <ul>
        {{#each jumpEvents}}
        <li class="ht-entry{{#unless enabled}} ht-resolved{{/unless}}">
          <button type="button" data-action="evToggle" data-id="{{id}}" title="{{#if enabled}}On (click to turn off){{else}}Off{{/if}}"><i class="fas {{#if enabled}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></button>
          <span class="ht-entry-name">{{name}}<small>weight {{weight}}{{#if fuel}} · +{{fuel}} fuel{{/if}}</small></span>
          <button type="button" data-action="evEdit" data-id="{{id}}" title="Edit"><i class="fas fa-pen"></i></button>
          <button type="button" data-action="evDelete" data-id="{{id}}" title="Delete"><i class="fas fa-trash"></i></button>
        </li>
        {{else}}<li class="ht-dim">No events. Add one or restore the defaults.</li>{{/each}}
      </ul>
      <div class="ht-row">
        <button type="button" data-action="evEdit"><i class="fas fa-plus"></i> New event</button>
        <button type="button" data-action="evRoll"><i class="fas fa-dice"></i> Roll one now</button>
        <button type="button" data-action="evReset"><i class="fas fa-rotate-left"></i> Defaults</button>
      </div>
    </details>
  </section>
  {{else}}
  <section class="ht-body">
    <ul>
    {{#each entries}}
      <li class="ht-entry">
        <span class="ht-entry-name">{{name}}<small>{{detail}}</small></span>
        <button type="button" data-action="toggle" data-id="{{id}}" title="Toggle player visibility"><i class="fas {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button>
        <button type="button" data-action="open" data-id="{{id}}" title="Open"><i class="fas fa-up-right-from-square"></i></button>
        <button type="button" data-action="show" data-id="{{id}}" title="Show to players"><i class="fas fa-users"></i></button>
        <button type="button" data-action="edit" data-id="{{id}}" title="Edit"><i class="fas fa-pen"></i></button>
        <button type="button" data-action="remove" data-id="{{id}}" title="Delete"><i class="fas fa-trash"></i></button>
      </li>
    {{else}}<li class="ht-dim">Nothing here yet.</li>{{/each}}
    </ul>
  </section>
  <div class="ht-row">
    <button type="button" data-action="create"><i class="fas fa-plus"></i> New</button>
    {{#if isShops}}<button type="button" data-action="importMej" title="Copy every Monk's Enhanced Journal shop into Holo-Terminal"><i class="fas fa-file-import"></i> Import Monk's shops</button>{{/if}}
  </div>
  {{/if}}
</div>
