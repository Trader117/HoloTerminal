<header class="holo-header">
  <div class="holo-ident">
    {{#if editMode}}
    <input class="holo-name" type="text" name="name" value="{{actor.name}}" placeholder="Name">
    {{else}}
    <h1 class="holo-name">{{actor.name}}</h1>
    {{/if}}
    <div class="holo-sub">
      {{#if species}}<span>{{species}}</span>{{/if}}
      {{#if classLine}}<span class="holo-strong">{{classLine}}</span>{{/if}}
      {{#if background}}<span>{{background}}</span>{{/if}}
      {{#if alignment}}<span>{{alignment}}</span>{{/if}}
    </div>
    <div class="holo-xp">
      <span class="holo-level">LVL {{level}}</span>
      {{#if xp.max}}
      <div class="holo-bar holo-xp-bar"><span style="width:{{xp.pct}}%"></span></div>
      <span class="holo-dim"><input type="text" name="system.details.xp.value" value="{{xp.value}}" data-delta data-current="{{xp.value}}"> / {{xp.max}} XP</span>
      {{/if}}
    </div>
  </div>
  <div class="holo-vitals">
    <div class="holo-stat holo-ac" data-tooltip="Armor Class"><label>AC</label><b>{{ac}}</b></div>
    <div class="holo-stat holo-click" data-action="rollInit" data-tooltip="Roll initiative"><label>INIT</label><b>{{init}}</b></div>
    <div class="holo-stat" data-tooltip="Proficiency bonus"><label>PROF</label><b>{{prof}}</b></div>
    <div class="holo-stat" data-tooltip="{{otherSpeeds}}"><label>SPEED</label><b>{{speed}}</b></div>
    <div class="holo-stat holo-click {{#if inspiration}}holo-on{{/if}}" data-action="toggleInspiration" data-tooltip="Inspiration"><label>INSPIRE</label><b><i class="fa-solid fa-star"></i></b></div>
  </div>
  <div class="holo-header-tools">
    {{#if editable}}
    <button type="button" class="holo-mode {{#if editMode}}holo-on{{/if}}" data-action="toggleMode" data-tooltip="Unlock to edit scores and details">
      {{#if editMode}}<i class="fa-solid fa-lock-open"></i> Editing{{else}}<i class="fa-solid fa-lock"></i> Play{{/if}}
    </button>
    {{/if}}
    <button type="button" data-action="rest" data-type="short"><i class="fa-solid fa-mug-hot"></i> {{localize "HOLOSHEET.ShortRest"}}</button>
    <button type="button" data-action="rest" data-type="long"><i class="fa-solid fa-bed"></i> {{localize "HOLOSHEET.LongRest"}}</button>
  </div>
</header>
