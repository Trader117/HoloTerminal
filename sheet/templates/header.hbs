<header class="holo-header">
  <div class="holo-ident">
    {{#if editMode}}
    <input class="holo-name" type="text" name="name" value="{{actor.name}}" placeholder="Name">
    {{else}}
    <h1 class="holo-name">{{actor.name}}</h1>
    {{/if}}
    <div class="holo-sub">
      {{#if classLine}}<span>{{classLine}}</span>{{/if}}
      {{#if species}}<span>{{species}}</span>{{/if}}
      {{#if background}}<span>{{background}}</span>{{/if}}
      {{#if alignment}}<span>{{alignment}}</span>{{/if}}
    </div>
  </div>
  <div class="holo-header-tools">
    <a class="holo-icon-btn" data-action="rest" data-type="short" data-tooltip="{{localize "HOLOSHEET.ShortRest"}}"><i class="fa-solid fa-utensils"></i></a>
    <a class="holo-icon-btn" data-action="rest" data-type="long" data-tooltip="{{localize "HOLOSHEET.LongRest"}}"><i class="fa-solid fa-campground"></i></a>
    <a class="holo-icon-btn {{#if inspiration}}holo-icon-on{{/if}}" data-action="toggleInspiration" data-tooltip="Inspiration"><i class="fa-solid fa-star"></i></a>
    {{#if editable}}<a class="holo-icon-btn" data-action="configurePrototypeToken" data-tooltip="Prototype token"><i class="fa-solid fa-user-circle"></i></a>
    <a class="holo-icon-btn" data-action="configureSheet" data-tooltip="Sheet settings"><i class="fa-solid fa-gear"></i></a>{{/if}}
    {{#if editable}}<a class="holo-icon-btn {{#if editMode}}holo-icon-on{{/if}}" data-action="toggleMode" data-tooltip="{{#if editMode}}Editing: click to lock{{else}}Locked: click to edit{{/if}}"><i class="fa-solid {{#if editMode}}fa-lock-open{{else}}fa-lock{{/if}}"></i></a>{{/if}}
  </div>
  <div class="holo-level-badge{{#if noXP}} holo-noxp{{/if}}" data-tooltip="{{#if noXP}}Level {{level}}{{else}}{{#if xp.max}}{{xp.value}} / {{xp.max}} XP{{/if}}{{/if}}">
    <svg viewBox="0 0 100 100" class="holo-level-ring"><circle cx="50" cy="50" r="44" class="track"/>{{#unless noXP}}<circle cx="50" cy="50" r="44" class="fill" style="stroke-dasharray:{{xp.pct}} 100" pathLength="100"/>{{/unless}}</svg>
    <span>{{level}}</span>
    {{#if canLevelUp}}<a class="holo-level-up" data-action="levelUp" data-tooltip="Level up"><i class="fa-solid fa-arrow-up"></i></a>{{/if}}
  </div>
</header>
