<section class="tab holo-body {{tab.cssClass}}" data-group="primary" data-tab="combat">
  <h3 class="holo-h">{{localize "HOLOSHEET.Weapons"}} <a data-action="createItem" data-type="weapon" data-tooltip="Add weapon"><i class="fa-solid fa-plus"></i></a></h3>
  <ul class="holo-list">{{#each weapons}}{{> "holo-terminal.sheet-item"}}{{else}}<li class="holo-dim holo-empty">{{localize "HOLOSHEET.Empty"}}</li>{{/each}}</ul>
  {{#each actionGroups}}
  <h3 class="holo-h">{{label}}</h3>
  <ul class="holo-list">{{#each items}}{{> "holo-terminal.sheet-item"}}{{/each}}</ul>
  {{else}}
  <h3 class="holo-h">{{localize "HOLOSHEET.Actions"}}</h3><p class="holo-dim holo-empty">No action features yet.</p>
  {{/each}}
  {{#if maneuvers.length}}
  <h3 class="holo-h">{{localize "HOLOSHEET.Maneuvers"}}</h3>
  <ul class="holo-list">{{#each maneuvers}}{{> "holo-terminal.sheet-item"}}{{/each}}</ul>
  {{/if}}
</section>
