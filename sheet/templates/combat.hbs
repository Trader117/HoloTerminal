<section class="tab holo-body {{tab.cssClass}}" data-group="primary" data-tab="combat">
  <div class="holo-table">
    <div class="holo-thead"><span class="holo-thead-title">{{localize "HOLOSHEET.Weapons"}}</span><span class="c-time">Time</span><span class="c-range">Range</span><span class="c-roll">Hit</span><span class="c-dmg">Damage</span><span class="c-uses">Uses</span>
      <span class="c-ctrl"><a data-action="createItem" data-type="weapon" data-tooltip="Add weapon"><i class="fa-solid fa-plus"></i></a></span></div>
    <ul class="holo-list">{{#each weapons}}{{> "holo-terminal.sheet-row" weapon=true showRoll=true}}{{else}}<li class="holo-dim holo-empty">{{localize "HOLOSHEET.Empty"}}</li>{{/each}}</ul>
  </div>
  {{#each actionGroups}}
  <div class="holo-table">
    <div class="holo-thead"><span class="holo-thead-title">{{label}}</span><span class="c-uses">Uses</span><span class="c-rec">Recovery</span><span class="c-ctrl"></span></div>
    <ul class="holo-list">{{#each items}}{{> "holo-terminal.sheet-row" feature=true}}{{/each}}</ul>
  </div>
  {{/each}}
  {{#if maneuvers.length}}
  <div class="holo-table">
    <div class="holo-thead"><span class="holo-thead-title">{{localize "HOLOSHEET.Maneuvers"}}</span><span class="c-uses">Uses</span><span class="c-rec">Recovery</span><span class="c-ctrl"></span></div>
    <ul class="holo-list">{{#each maneuvers}}{{> "holo-terminal.sheet-row" feature=true}}{{/each}}</ul>
  </div>
  {{/if}}
</section>
