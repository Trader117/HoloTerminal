<aside class="holo-sidebar">
  <div class="holo-portrait-wrap">
    <img class="holo-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-tooltip="Change portrait">
    <div class="holo-hp holo-hp-{{hp.state}}">
      <div class="holo-hp-bar"><span class="holo-hp-fill" style="width:{{hp.pct}}%"></span>{{#if hp.temp}}<span class="holo-hp-temp" style="width:{{hp.tempPct}}%"></span>{{/if}}</div>
      <div class="holo-hp-nums">
        <label>HP</label>
        <input type="text" name="system.attributes.hp.value" value="{{hp.value}}" data-delta data-current="{{hp.value}}" data-tooltip="Type -5 or +5 to adjust">
        <span class="holo-hp-max">/ {{hp.max}}</span>
        <input class="holo-temp" type="text" name="system.attributes.hp.temp" value="{{#if hp.temp}}{{hp.temp}}{{/if}}" placeholder="+tmp" data-delta data-current="{{hp.temp}}" data-tooltip="Temporary HP">
      </div>
    </div>
  </div>

  {{#if death.show}}
  <section class="holo-side-block holo-death">
    <h4>{{localize "HOLOSHEET.DeathSaves"}}</h4>
    <div class="holo-death-row"><span class="holo-dim">Success</span>{{#each death.successPips}}<i class="holo-pip holo-pip-good {{#if this}}on{{/if}}"></i>{{/each}}</div>
    <div class="holo-death-row"><span class="holo-dim">Failure</span>{{#each death.failurePips}}<i class="holo-pip holo-pip-bad {{#if this}}on{{/if}}"></i>{{/each}}</div>
    <button type="button" data-action="deathSave"><i class="fa-solid fa-skull"></i> Roll death save</button>
  </section>
  {{/if}}

  {{#if hitDice.length}}
  <section class="holo-side-block">
    <h4>Hit Dice</h4>
    <div class="holo-hd">
      {{#each hitDice}}<button type="button" data-action="rollHitDie" data-denom="{{denom}}" data-tooltip="Spend a {{denom}}" {{#unless value}}disabled{{/unless}}><b>{{value}}</b>/{{max}} {{denom}}</button>{{/each}}
    </div>
  </section>
  {{/if}}

  {{#if force.show}}
  <section class="holo-side-block holo-pool holo-force"><h4>{{localize "HOLOSHEET.ForcePoints"}}</h4>
    <div class="holo-bar"><span style="width:{{force.pct}}%"></span></div>
    <div class="holo-pool-nums"><input type="text" name="{{force.path}}" value="{{force.value}}" data-delta data-current="{{force.value}}"><span>/ {{force.max}}</span></div>
  </section>
  {{/if}}
  {{#if tech.show}}
  <section class="holo-side-block holo-pool holo-tech"><h4>{{localize "HOLOSHEET.TechPoints"}}</h4>
    <div class="holo-bar"><span style="width:{{tech.pct}}%"></span></div>
    <div class="holo-pool-nums"><input type="text" name="{{tech.path}}" value="{{tech.value}}" data-delta data-current="{{tech.value}}"><span>/ {{tech.max}}</span></div>
  </section>
  {{/if}}
  {{#if superiority.show}}
  <section class="holo-side-block holo-pool holo-sup"><h4>{{localize "HOLOSHEET.Superiority"}} {{superiority.die}}</h4>
    <div class="holo-bar"><span style="width:{{superiority.pct}}%"></span></div>
    <div class="holo-pool-nums"><input type="text" name="system.superiority.dice.value" value="{{superiority.value}}" data-delta data-current="{{superiority.value}}"><span>/ {{superiority.max}}</span></div>
  </section>
  {{/if}}

  <section class="holo-side-block">
    <h4>Exhaustion</h4>
    <div class="holo-exhaustion">
      {{#each exhaustion.pips}}<a class="holo-pip-box {{#if on}}on{{/if}}" data-action="setExhaustion" data-level="{{n}}" data-tooltip="Level {{n}}">{{n}}</a>{{/each}}
    </div>
  </section>

  <section class="holo-side-block">
    <h4>Conditions</h4>
    {{#if activeConditions.length}}
    <div class="holo-chips">{{#each activeConditions}}<a class="holo-chip holo-chip-on" data-action="toggleCondition" data-condition-id="{{id}}" data-tooltip="Click to remove"><img src="{{img}}">{{name}}</a>{{/each}}</div>
    {{else}}<p class="holo-dim holo-small">None. Add them from the Effects tab.</p>{{/if}}
  </section>

  {{#each traits}}
  <section class="holo-side-block holo-trait">
    <h4>{{label}}</h4>
    <p>{{#each values}}<span>{{this}}</span>{{/each}}</p>
  </section>
  {{/each}}
  {{#if editMode}}
  <section class="holo-side-block holo-trait-edit">
    <h4>Edit traits</h4>
    <div class="holo-chips">
      <a class="holo-chip" data-action="editTraits" data-trait="senses">Senses</a>
      <a class="holo-chip" data-action="editTraits" data-trait="languages">Languages</a>
      <a class="holo-chip" data-action="editTraits" data-trait="armor">Armor</a>
      <a class="holo-chip" data-action="editTraits" data-trait="weapon">Weapons</a>
      <a class="holo-chip" data-action="editTraits" data-trait="tool">Tools</a>
      <a class="holo-chip" data-action="editTraits" data-trait="dr">Resist</a>
      <a class="holo-chip" data-action="editTraits" data-trait="di">Immune</a>
      <a class="holo-chip" data-action="editTraits" data-trait="dv">Vulnerable</a>
      <a class="holo-chip" data-action="editTraits" data-trait="ci">Cond. immune</a>
    </div>
  </section>
  {{/if}}
</aside>
