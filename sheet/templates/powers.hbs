<section class="tab holo-body {{tab.cssClass}}" data-group="primary" data-tab="powers">
  <div class="holo-cast-cards">
    {{#each castCards}}
    <div class="holo-cast-card {{cls}}">
      <div class="holo-cast-head"><span>{{label}}</span><b>{{points.value}} / {{points.max}}</b></div>
      <table><thead><tr><th></th><th>Ability</th><th>Attack</th><th>Power DC</th></tr></thead>
        <tbody>{{#each schools}}<tr><td class="holo-school-{{key}}">{{label}}</td><td>{{mod}} <small>{{attr}}</small></td><td>{{attack}}</td><td>{{dc}}</td></tr>{{/each}}</tbody></table>
      <div class="holo-cast-known{{#if known.short}} holo-short{{/if}}"><span>Powers known <b>{{known.text}}</b></span>
        {{#if @root.editable}}<a class="holo-learn-btn" data-action="learnPowers" data-cast="{{cast}}"><i class="fa-solid fa-plus"></i> Learn powers</a>{{/if}}</div>
    </div>
    {{/each}}
  </div>
  <div class="holo-search-row"><i class="fa-solid fa-magnifying-glass"></i><input class="holo-search" data-scope="powers" type="search" placeholder="Search powers" value="{{search.powers}}"></div>
  {{#if forcePowers.length}}<h3 class="holo-h holo-force-h">Force Powers <a data-action="createItem" data-type="spell" data-school="uni" data-tooltip="Add force power"><i class="fa-solid fa-plus"></i></a></h3>{{/if}}
  {{#each forcePowers}}
  <div class="holo-table">
    <div class="holo-thead"><span class="holo-thead-title">{{label}}</span><span class="c-school"></span><span class="c-time">Time</span><span class="c-range">Range</span><span class="c-roll">Roll</span><span class="c-cost">Cost</span><span class="c-uses">Uses</span><span class="c-ctrl"></span></div>
    <ul class="holo-list">{{#each powers}}{{> "holo-terminal.sheet-row" power=true showRoll=true}}{{/each}}</ul>
  </div>
  {{/each}}
  {{#if techPowers.length}}<h3 class="holo-h holo-tech-h">Tech Powers <a data-action="createItem" data-type="spell" data-school="tec" data-tooltip="Add tech power"><i class="fa-solid fa-plus"></i></a></h3>{{/if}}
  {{#each techPowers}}
  <div class="holo-table">
    <div class="holo-thead"><span class="holo-thead-title">{{label}}</span><span class="c-school"></span><span class="c-time">Time</span><span class="c-range">Range</span><span class="c-roll">Roll</span><span class="c-cost">Cost</span><span class="c-uses">Uses</span><span class="c-ctrl"></span></div>
    <ul class="holo-list">{{#each powers}}{{> "holo-terminal.sheet-row" power=true showRoll=true}}{{/each}}</ul>
  </div>
  {{/each}}
  {{#each otherPowers}}
  <div class="holo-table">
    <div class="holo-thead"><span class="holo-thead-title">{{label}}</span><span class="c-school"></span><span class="c-time">Time</span><span class="c-range">Range</span><span class="c-roll">Roll</span><span class="c-cost">Cost</span><span class="c-uses">Uses</span><span class="c-ctrl"></span></div>
    <ul class="holo-list">{{#each powers}}{{> "holo-terminal.sheet-row" power=true showRoll=true}}{{/each}}</ul>
  </div>
  {{/each}}
  {{#unless powerCount}}
  <p class="holo-dim holo-empty">{{localize "HOLOSHEET.NoPowers"}}
    <a data-action="createItem" data-type="spell" data-school="uni">Add a force power</a> or <a data-action="createItem" data-type="spell" data-school="tec">a tech power</a>, or drag them in from a compendium.</p>
  {{/unless}}
</section>
