<section class="tab holo-body holo-overview {{tab.cssClass}}" data-group="primary" data-tab="overview">
  <div class="holo-abilities">
    {{#each abilities}}
    <div class="holo-ability" data-ability="{{key}}">
      <a class="holo-abbr" data-action="rollAbility" data-tooltip="{{label}} check">{{abbr}}</a>
      <b class="holo-mod" data-action="rollAbility">{{mod}}</b>
      <input type="number" name="system.abilities.{{key}}.value" value="{{value}}">
      <a class="holo-save {{#if proficient}}holo-on{{/if}}" data-action="rollSave" data-tooltip="{{label}} save">SAVE {{save}}</a>
    </div>
    {{/each}}
  </div>
  <h3 class="holo-h">Skills</h3>
  <ul class="holo-skills">
    {{#each skills}}
    <li data-skill="{{key}}" data-action="rollSkill">
      <i class="{{icon}}"></i><span class="holo-skill-name">{{label}}</span>
      <span class="holo-dim">{{ability}}</span><b>{{total}}</b><span class="holo-dim" data-tooltip="Passive">({{passive}})</span>
    </li>
    {{/each}}
  </ul>
</section>
