<section class="tab holo-body {{tab.cssClass}}" data-group="primary" data-tab="effects">
  {{#each effectGroups}}
  <div class="holo-table">
    <div class="holo-thead"><span class="holo-thead-title">{{label}} Effects</span><span class="c-src">Source</span><span class="c-dur">Duration</span>
      <span class="c-ctrl"><a data-action="createEffect" data-type="{{type}}" data-tooltip="Add effect"><i class="fa-solid fa-plus"></i></a></span></div>
    <ul class="holo-list">
      {{#each items}}
      <li class="holo-item" data-effect-uuid="{{uuid}}">
        <div class="holo-item-row">
          <img src="{{img}}" data-action="editEffect">
          <div class="holo-item-main"><a class="holo-item-name" data-action="editEffect">{{name}}</a></div>
          <span class="c-src holo-dim">{{source}}</span>
          <span class="c-dur holo-dim">{{#if duration}}{{duration}}{{else}}–{{/if}}</span>
          <span class="c-ctrl holo-controls">
            <a data-action="toggleEffect" class="holo-switch {{#unless disabled}}on{{/unless}}" data-tooltip="{{#if disabled}}Enable{{else}}Disable{{/if}}"><i></i></a>
            <a data-action="editEffect" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></a>
            <a data-action="deleteEffect" class="holo-edit-only" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></a>
          </span>
        </div>
      </li>
      {{else}}<li class="holo-dim holo-small holo-empty">None.</li>{{/each}}
    </ul>
  </div>
  {{/each}}
  <div class="holo-table">
    <div class="holo-thead"><span class="holo-thead-title">Conditions</span></div>
    <div class="holo-exhaustion-row"><span>Exhaustion</span>
      {{#each exhaustion.pips}}<a class="holo-pip-box {{#if on}}on{{/if}}" data-action="setExhaustion" data-level="{{n}}" data-tooltip="Level {{n}}">{{n}}</a>{{/each}}
    </div>
    <div class="holo-cond-grid">
      {{#each conditions}}
      <a class="holo-cond {{#if active}}holo-cond-on{{/if}}" data-action="toggleCondition" data-condition-id="{{id}}"><img src="{{img}}"><span>{{name}}</span><span class="holo-switch {{#if active}}on{{/if}}"><i></i></span></a>
      {{/each}}
    </div>
  </div>
</section>
