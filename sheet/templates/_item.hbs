<li class="holo-item draggable" data-item-id="{{id}}" draggable="true">
  <div class="holo-item-row">
    <img src="{{img}}" data-action="useItem" data-tooltip="Use">
    <a class="holo-item-name" data-action="expandItem">{{name}}</a>
    {{#if schoolLabel}}<span class="holo-badge holo-school-{{school}}">{{schoolLabel}}</span>{{/if}}
    {{#if concentration}}<span class="holo-badge" data-tooltip="Concentration">C</span>{{/if}}
    {{#if cost}}<span class="holo-dim">{{cost}} pt</span>{{/if}}
    <span class="holo-item-summary holo-dim">{{summary}}</span>
    {{#if uses}}<span class="holo-uses">{{uses.value}}/{{uses.max}}</span>{{/if}}
    {{#if quantity}}<span class="holo-qty">×{{quantity}}</span>{{/if}}
    <span class="holo-controls">
      {{#if equippable}}<a data-action="toggleEquip" class="{{#if equipped}}holo-on{{/if}}" data-tooltip="Equip"><i class="fa-solid fa-shield-halved"></i></a>{{/if}}
      <a data-action="editItem" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></a>
      <a data-action="deleteItem" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></a>
    </span>
  </div>
</li>
