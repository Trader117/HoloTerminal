<li class="holo-item draggable {{#if isContainer}}holo-container{{/if}}" data-item-id="{{id}}" draggable="true" {{#if isContainer}}data-container-id="{{id}}"{{/if}}>
  <div class="holo-item-row">
    <img src="{{img}}" data-action="useItem" data-tooltip="Use {{name}}">
    <div class="holo-item-main">
      <div class="holo-item-title">
        {{#if isContainer}}<a class="holo-caret" data-action="toggleContainer"><i class="fa-solid {{#if open}}fa-caret-down{{else}}fa-caret-right{{/if}}"></i></a>{{/if}}
        <a class="holo-item-name" data-action="expandItem" data-tooltip="Show description">{{name}}</a>
        {{#if concentration}}<span class="holo-badge holo-conc" data-tooltip="Concentration">C</span>{{/if}}
        {{#if isContainer}}<span class="holo-dim holo-small">({{count}})</span>{{/if}}
      </div>
      {{#if subtitle}}<span class="holo-item-sub">{{subtitle}}</span>{{/if}}
    </div>
    {{#if power}}
      <span class="c-school">{{#if schoolLabel}}<span class="holo-badge holo-school-{{school}}">{{schoolLabel}}</span>{{/if}}</span>
      <span class="c-time">{{#if time}}{{time}}{{else}}–{{/if}}</span>
      <span class="c-range">{{#if range}}{{range}}{{else}}–{{/if}}</span>
    {{/if}}
    {{#if weapon}}
      <span class="c-time">{{#if time}}{{time}}{{else}}–{{/if}}</span>
      <span class="c-range">{{#if range}}{{range}}{{else}}–{{/if}}</span>
    {{/if}}
    {{#if showRoll}}
      <span class="c-roll">{{#if roll.hit}}<b>{{roll.hit}}</b>{{else if roll.dc}}<span class="holo-save-cell"><small>{{roll.ability}}</small><b>{{roll.dc}}</b></span>{{else if roll.text}}{{roll.text}}{{else}}–{{/if}}</span>
    {{/if}}
    {{#if weapon}}<span class="c-dmg">{{#if damage}}{{damage}}{{else}}–{{/if}}</span>{{/if}}
    {{#if power}}<span class="c-cost">{{#if cost}}<b>{{cost}}</b> pt{{else}}–{{/if}}</span>{{/if}}
    {{#if gear}}
      <span class="c-price">{{#if price}}{{price}}{{else}}–{{/if}}</span>
      <span class="c-weight">{{#if weight}}<i class="fa-solid fa-weight-hanging"></i> {{weight}}{{else}}–{{/if}}</span>
      <span class="c-qty">{{#if hasQty}}<a data-action="adjustQty" data-step="-1">−</a><input type="text" data-item-field="system.quantity" value="{{quantity}}"><a data-action="adjustQty" data-step="1">+</a>{{else}}–{{/if}}</span>
    {{/if}}
    <span class="c-uses">{{#if uses}}<input type="text" data-item-field="system.uses.value" value="{{uses.value}}"><span class="holo-dim">/ {{uses.max}}</span>{{else}}–{{/if}}</span>
    {{#if feature}}<span class="c-rec">{{#if recovery}}{{recovery}}{{else}}–{{/if}}</span>{{/if}}
    <span class="c-ctrl holo-controls">
      {{#if equippable}}<a data-action="toggleEquip" class="holo-equip {{#if equipped}}holo-equip-on{{/if}}" data-tooltip="{{#if equipped}}Unequip{{else}}Equip{{/if}}"><i class="fa-solid fa-shield-halved"></i></a>{{/if}}
      <a data-action="toggleFavorite" class="holo-fav {{#if favorite}}holo-fav-on{{/if}}" data-tooltip="Favourite"><i class="fa-solid fa-star"></i></a>
      <a data-action="editItem" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></a>
      <a data-action="deleteItem" class="holo-edit-only" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></a>
    </span>
  </div>
  {{#if open}}
  <ul class="holo-list holo-contents">{{#each contents}}{{> "holo-terminal.sheet-row" gear=true}}{{else}}<li class="holo-dim holo-small holo-empty">Empty. Drag items here.</li>{{/each}}</ul>
  {{/if}}
</li>
