<section class="tab holo-body holo-ship-cargo {{tab.cssClass}}" data-group="primary" data-tab="cargo">
  <h3 class="holo-h"><span>Cargo hold</span><span class="holo-ship-count">{{ship.cargoUsed}}{{#if ship.cargoCap}} / {{ship.cargoCap}}{{/if}} t</span></h3>
  {{#if ship.cargoCap}}<div class="holo-meter-bar holo-ship-hold"><span class="holo-meter-fill" style="width:{{cargoPct}}%"></span></div>{{/if}}
  <ul class="holo-ship-list">
    {{#each cargo}}
    <li class="holo-ship-row"><span class="holo-ship-qty-tag">&times;{{qty}}</span>
      <div class="holo-ship-main"><span>{{name}}</span><small>{{#if good}}trade goods{{#if from}} from {{from}}{{/if}}{{else}}{{#if tons}}{{tons}} t each{{/if}}{{/if}}</small></div>
      {{#if ../canCommand}}<span class="holo-controls"><a data-action="shipCargoRemove" data-id="{{id}}" data-tooltip="{{#if data}}Throw it out (take it into your gear from the datapad's Cargo tab instead){{else}}Unload{{/if}}"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}
    </li>
    {{else}}<li class="holo-dim holo-empty">The hold is empty.</li>{{/each}}
  </ul>
  {{#if canCommand}}
  <div class="holo-ship-cargo-add">
    <input type="text" data-ship-cargo="name" placeholder="Cargo"><input type="number" min="1" value="1" data-ship-cargo="qty" data-tooltip="Quantity"><input type="number" min="0" step="0.1" data-ship-cargo="tons" placeholder="t" data-tooltip="Tons each">
    <button type="button" data-action="shipCargoAdd"><i class="fa-solid fa-plus"></i> Load</button>
  </div>
  {{/if}}
  {{#if inDock}}
  <h3 class="holo-h">Location &amp; log</h3>
  {{#if editable}}
  <div class="holo-ship-edit holo-ship-edit-wide">
    <label>Location <input type="text" name="flags.holo-terminal.ship.location" value="{{location}}" placeholder="e.g. Docking bay 94, Mos Eisley"></label>
    <label>Captain's log <textarea name="flags.holo-terminal.ship.notes" rows="4">{{shipLog}}</textarea></label>
  </div>
  {{else}}<p>{{#if location}}<i class="fa-solid fa-location-dot"></i> {{location}}{{/if}}</p><p class="holo-ship-log">{{shipLog}}</p>{{/if}}
  {{/if}}
</section>
